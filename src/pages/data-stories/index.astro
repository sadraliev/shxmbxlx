---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DataStoryCard from "../../components/DataStoryCard.astro";

const stories = (
  await getCollection("data-stories", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Data stories — shxmbxlx"
  description="Data, turned into stories."
>
  <div class="prose">
    <h1>Data stories</h1>
    <p>
      <em>Data, turned into stories.</em>
    </p>
  </div>

  {
    stories.length === 0 ? (
      <p class="text-muted-foreground italic py-2">No data stories yet.</p>
    ) : (
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {stories.map((entry) => (
          <DataStoryCard
            href={`/data-stories/${entry.id}`}
            reload={true}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            accent={entry.data.accent}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
