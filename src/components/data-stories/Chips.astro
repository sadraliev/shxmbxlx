---
interface Props {
  hashtags: { tag: string; posts: number }[];
}

const { hashtags } = Astro.props;
---

<div class="chips">
  {
    hashtags.map((h) => (
      <span class="chip">
        <b>#{h.tag}</b>
        <span class="c">{h.posts}</span>
      </span>
    ))
  }
</div>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 13px;
    font-size: 14px;
    color: var(--ink-2);
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
  }
  .chip b {
    color: var(--ink);
  }
  .c {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 12px;
    color: var(--accent);
  }
</style>
